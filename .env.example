# Configurações da API NVIDIA (Obrigatório para análise neural)
NVIDIA_API_KEY=nvapi-sua-chave-aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ambiente de execução (development | production)
APP_ENV=development

# Timeouts e limites
TIMEOUT_EXTRACTION=20
TIMEOUT_OPTIMIZATION=90
TIMEOUT_EMBEDDING=30
TIMEOUT_AUDIT=120
TIMEOUT_PDF=30
HTTPX_TIMEOUT=240
AUDIT_MAX_TOKENS=1500
MAX_UPLOAD_MB=10

# Banco de dados SQLite para persistência
DATABASE_URL=sqlite:///./data/ats.db
